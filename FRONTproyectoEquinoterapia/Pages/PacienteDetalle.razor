@page "/pacientes/detalle/{id:int}"
@using FRONTproyectoEquinoterapia.Models
@using Microsoft.AspNetCore.Components.Forms
@using FRONTproyectoEquinoterapia.Services
@inject NavigationManager NavManager
@inject HttpClient Http
@inject IJSRuntime JS
@inject PacienteService PacienteService
@inject ArchivoService ArchivoService

<div class="card shadow-sm p-4 mt-3">

    <h3 class="text-primary mb-3">Detalle del Paciente</h3>

    @if (cargando)
    {
        <div class="text-center my-4">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">Cargando...</p>
        </div>
    }
    else if (pacienteDetalle == null)
    {
        <div class="alert alert-danger">Paciente no encontrado.</div>
    }
    else
    {
        <!-- Datos generales -->
        <h4 class="mb-3">@pacienteDetalle.Nombre</h4> 

        @if (!modoEdicion)
        {
            <p><strong>Tutor:</strong> @pacienteDetalle.Tutor</p>
            <p><strong>Teléfono:</strong> @pacienteDetalle.TelefonoTutor</p>
            <p><strong>Género:</strong> @pacienteDetalle.Genero</p>
            <p><strong>Estado:</strong> @pacienteDetalle.Estado</p>
            <p><strong>Numero de Faltas:</strong> @pacienteDetalle.NumeroFaltas</p>
        }
        else
        {
            <InputText @bind-Value="pacienteDetalle.Nombre" class="form-control mb-2" placeholder="Nombre del paciente" />
            <div class="mb-2">
                <label class="form-label">Tutor</label>
                <InputText @bind-Value="pacienteDetalle.Tutor" class="form-control" />
            </div>

            <div class="mb-2">
                <label class="form-label">Nombre</label>
                <InputText @bind-Value="pacienteDetalle.Nombre" class="form-control mb-2" placeholder="Nombre del paciente" />
            </div>
            <div class="mb-2">
                <label class="form-label">Teléfono</label>
                <InputText @bind-Value="pacienteDetalle.TelefonoTutor" class="form-control" />
            </div>
            <div class="mb-2">
                <label class="form-label">Género</label>
                <InputSelect @bind-Value="pacienteDetalle.Genero" class="form-select">
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>
                </InputSelect>
            </div>
            <div class="mb-2">
                <label class="form-label">Estado</label>
                <InputSelect @bind-Value="pacienteDetalle.Estado" class="form-select">                  
                    <option value="EnTratamiento">En Tratamiento</option>
                    <option value="Baja">Baja</option>
                </InputSelect>
            </div>


            <RadzenButton Text="Guardar cambios"
                          Icon="save"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="GuardarCambios" />
            <RadzenButton Text="Cancelar"
                          Icon="close"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="CancelarEdicion" class="ms-2" />
        }

        @if (!modoEdicion)
        {
            <RadzenButton Text="Editar"
                          Icon="edit"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => modoEdicion = true)" class="mt-2" />
        }

        <hr class="my-4" />

        <!-- Archivos -->
        <h5 class="text-secondary mb-3">Archivos del Paciente</h5>

        @foreach (var tipo in tiposArchivo)
        {
            <div class="border rounded p-3 mb-3 bg-light">

                <label class="fw-bold">@tipo.Nombre (@tipo.Extension)</label>

                @if (ArchivoExisteDict[tipo.Nombre])
                {
                    <div class="mt-2 d-flex align-items-center gap-2">

                        <RadzenButton Text="Descargar"
                                      Icon="download"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="() => DescargarArchivo(tipo.Nombre)" />

                        <RadzenButton Text="Eliminar"
                                      Icon="delete"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Click="() => ConfirmarEliminarArchivo(tipo.Nombre)" />

                        <label class="btn btn-outline-secondary btn-sm m-0">
                            @((archivosSeleccionados.ContainsKey(tipo.Nombre)
                                            ? archivosSeleccionados[tipo.Nombre].Name
                                            : "Seleccionar archivo"))
                <InputFile class="d-none"
                           OnChange="e => OnArchivoSeleccionado(e, tipo.Nombre)" />
            </label>

                        <RadzenButton Text="Actualizar"
                                      Icon="upload"
                                      ButtonStyle="ButtonStyle.Warning"
                                      Size="ButtonSize.Small"
                                      Click="() => ConfirmarActualizarArchivo(tipo.Nombre)" />

                    </div>

        @if (mensajeErrorArchivo.ContainsKey(tipo.Nombre))
                    {
                        <div class="text-danger mt-1">@mensajeErrorArchivo[tipo.Nombre]</div>
                    }

                    @if (mensajeOperacionArchivo.ContainsKey(tipo.Nombre))
                    {
                        <div class="text-success mt-1">@mensajeOperacionArchivo[tipo.Nombre]</div>
                    }
                }
                else
                {
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <InputFile class="form-control"
                                   OnChange="e => OnArchivoSeleccionado(e, tipo.Nombre)" />

                        <RadzenButton Text="Subir"
                                      Icon="upload"
                                      ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Small"
                                      Click="() => SubirArchivo(tipo.Nombre)" />
                    </div>

                    @if (mensajeErrorArchivo.ContainsKey(tipo.Nombre))
                    {
                        <div class="text-danger mt-1">@mensajeErrorArchivo[tipo.Nombre]</div>
                    }

                    @if (mensajeOperacionArchivo.ContainsKey(tipo.Nombre))
                    {
                        <div class="text-success mt-1">@mensajeOperacionArchivo[tipo.Nombre]</div>
                    }
                }

            </div>
        }

        @if (!string.IsNullOrEmpty(mensajeOperacion))
        {
            <div class="alert alert-success mt-3">@mensajeOperacion</div>
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger mt-3">@mensajeError</div>
        }
    }

    @if (archivoParaVer != null)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@archivoParaVer.Nombre</h5>
                        <button type="button" class="btn-close" @onclick="CerrarVistaArchivo"></button>
                    </div>
                    <div class="modal-body">
                        <iframe style="width:100%; height:80vh;" src="@archivoParaVer.Url" frameborder="0"></iframe>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public int id { get; set; }

    private PacienteDetailsDto? pacienteDetalle;
    private List<ArchivoService.TipoArchivoDto> tiposArchivo = new();
    private Dictionary<string, IBrowserFile> archivosSeleccionados = new();
    private Dictionary<string, bool> ArchivoExisteDict = new();
    private bool modoEdicion = false;

    private Dictionary<string, string> mensajeErrorArchivo = new();
    private Dictionary<string, string> mensajeOperacionArchivo = new();

    private bool cargando = true;
    private string mensajeError = "";
    private string mensajeOperacion = "";

    private ArchivoVistaDto? archivoParaVer;

    protected override async Task OnInitializedAsync()
    {
        tiposArchivo = await ArchivoService.ObtenerTiposAsync();
        await CargarPaciente();
    }

    private async Task CargarPaciente()
    {
        cargando = true;
        pacienteDetalle = await PacienteService.ObtenerPorIdAsync(id);

        ArchivoExisteDict.Clear();
        foreach (var tipo in tiposArchivo)
        {
            ArchivoExisteDict[tipo.Nombre] = await ArchivoExiste(tipo.Nombre);
        }

        cargando = false;
    }

    private void OnArchivoSeleccionado(InputFileChangeEventArgs e, string nombreArchivo)
    {
        archivosSeleccionados[nombreArchivo] = e.File;
        mensajeErrorArchivo[nombreArchivo] = "";
        mensajeOperacionArchivo[nombreArchivo] = "";
    }

    private async Task<bool> ArchivoExiste(string nombreArchivo)
    {
        try
        {
            var response = await Http.GetAsync($"api/pacientes/{id}/archivos/{nombreArchivo}", HttpCompletionOption.ResponseHeadersRead);
            return response.IsSuccessStatusCode;
        }
        catch { return false; }
    }

    private async Task SubirArchivo(string nombreArchivo)
    {
        if (!archivosSeleccionados.ContainsKey(nombreArchivo))
        {
            mensajeErrorArchivo[nombreArchivo] = "Seleccione un archivo para subir.";
            return;
        }

        var file = archivosSeleccionados[nombreArchivo];
        var resultado = await ArchivoService.SubirArchivoAsync(id, file, nombreArchivo);

        if (resultado.exito)
        {
            mensajeOperacionArchivo[nombreArchivo] = resultado.mensaje;
            archivosSeleccionados.Remove(nombreArchivo);
            await CargarPaciente();
        }
        else
        {
            mensajeErrorArchivo[nombreArchivo] = resultado.mensaje;
        }
    }

    private async Task ConfirmarActualizarArchivo(string nombreArchivo)
    {
        if (!archivosSeleccionados.ContainsKey(nombreArchivo))
        {
            mensajeErrorArchivo[nombreArchivo] = "Seleccione un archivo para actualizar.";
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"El archivo actual será reemplazado. ¿Desea continuar?");
        if (!confirm) return;

        var file = archivosSeleccionados[nombreArchivo];
        var resultado = await ArchivoService.ActualizarArchivoAsync(id, file, nombreArchivo);

        if (resultado.exito)
        {
            mensajeOperacionArchivo[nombreArchivo] = resultado.mensaje;
            archivosSeleccionados.Remove(nombreArchivo);
            await CargarPaciente();
        }
        else
        {
            mensajeErrorArchivo[nombreArchivo] = resultado.mensaje;
        }
    }

    private async Task ConfirmarEliminarArchivo(string nombreArchivo)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"El archivo '{nombreArchivo}' se eliminará por completo. ¿Está seguro?");
        if (!confirm) return;

        var resultado = await ArchivoService.EliminarArchivoAsync(id, nombreArchivo);
        if (resultado.exito)
        {
            mensajeOperacionArchivo[nombreArchivo] = resultado.mensaje;
            await CargarPaciente();
        }
        else
        {
            mensajeErrorArchivo[nombreArchivo] = resultado.mensaje;
        }
    }


    private void DescargarArchivo(string nombreArchivo)
    {
        var url = $"https://localhost:7280/api/pacientes/{id}/archivos/{nombreArchivo}";
        JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void EditarPaciente()
    {
        modoEdicion = true;
        mensajeError = "";
        mensajeOperacion = "";
    }

    private async Task GuardarCambios()
    {
        if (pacienteDetalle == null) return;

        // 🔹 Mapear PacienteDetailsDto a UpdatePacienteDto
        var dtoParcial = new UpdatePacienteDto
        {
            PacienteId = pacienteDetalle.PacienteId, // Asegúrate de usar Id, no 0
            Nombre = pacienteDetalle.Nombre,
            Tutor = pacienteDetalle.Tutor,
            TelefonoTutor = pacienteDetalle.TelefonoTutor,
            Genero = pacienteDetalle.Genero,
            Estado = pacienteDetalle.Estado
        };

        try
        {
            // 🔹 Llamada al service con el tipo correcto
            var resultado = await PacienteService.ActualizarParcialAsync(dtoParcial);

            // 🔹 Destructuración del tuple manual
            bool exito = resultado.exito;
            string mensaje = resultado.mensaje;

            if (exito)
            {
                mensajeOperacion = "Paciente actualizado correctamente.";
                modoEdicion = false;
            }
            else
            {
                mensajeError = mensaje;
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al actualizar: {ex.Message}";
        }
    }




    private async Task CancelarEdicion()
    {
        modoEdicion = false;
        mensajeError = "";
        mensajeOperacion = "";
        await CargarPaciente();
    }

    private void CerrarVistaArchivo()
    {
        archivoParaVer = null;
    }

    private class ArchivoVistaDto
    {
        public string Nombre { get; set; } = "";
        public string Url { get; set; } = "";
    }
}








