@page "/pacientes/detalle/{id:int}"
@using FRONTproyectoEquinoterapia.Models
@using Microsoft.AspNetCore.Components.Forms
@inject PacienteService PacienteService
@inject ArchivoService ArchivoService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using FRONTproyectoEquinoterapia.Services
@inject NavigationManager Navigation
@inject HttpClient Http
@inject FRONTproyectoEquinoterapia.Services.ArchivoService ArchivoService
@using Microsoft.JSInterop
@inject ArchivoService ArchivoService
@inject IJSRuntime JS

<h3>Detalle del Paciente</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (pacienteDetalle == null)
{
    <p>Paciente no encontrado.</p>
}
else
{
    <div>
        <h4>@pacienteDetalle.Paciente?.Nombre</h4>
        <p><strong>Tutor:</strong> @pacienteDetalle.Paciente?.Tutor</p>
        <p><strong>Teléfono:</strong> @pacienteDetalle.Paciente?.TelefonoTutor</p>
        <p><strong>Género:</strong> @pacienteDetalle.Paciente?.Genero</p>
        <p><strong>Faltas:</strong> @pacienteDetalle.NumeroFaltas</p>
        <p><strong>Falta evaluación:</strong> @pacienteDetalle.FaltaEvaluacion</p>

        <h5>Archivos</h5>
        @if (archivosLista.Any())
        {
            <ul>
                @foreach (var archivo in archivosLista)
                {
                    <li>
                        @archivo.Nombre
                        <button @onclick="() => DescargarArchivo(archivo)">Descargar</button>
                        <InputFile OnChange="e => OnArchivoSeleccionado(e, archivo.Nombre)" />
                        <button @onclick="() => ActualizarArchivo(archivo.Nombre)">Actualizar</button>
                        <button @onclick="() => EliminarArchivo(archivo.Nombre)">Eliminar</button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No hay archivos.</p>
        }

        <h5>Subir nuevo archivo</h5>

        <select @bind="nuevoArchivoDto.TipoArchivoId">
            <option value="0">-- Selecciona tipo de archivo --</option>
            @foreach (var tipo in tiposArchivo)
            {
                <option value="@tipo.TipoId">@tipo.Nombre (@tipo.Extension)</option>
            }
        </select>

        <InputFile OnChange="OnNuevoArchivoSeleccionado" />

        <button @onclick="SubirArchivo">Subir Archivo</button>

        <p>@mensajeOperacion</p>

    </div>
}

@code {
    [Parameter] public int id { get; set; }

    private PacienteDetalleResponse? pacienteDetalle;
    private List<AddArchivoBlazorDto> archivosLista = new();
    private bool cargando = true;
    private string mensajeOperacion = string.Empty;
    private List<ArchivoService.TipoArchivoDto> tiposArchivoLista = new();
    private AddArchivoBlazorDto nuevoArchivoDto = new(); // Para bind del select y archivo
    private List<ArchivoService.TipoArchivoDto> tiposArchivo = new();
    private ArchivoService.TipoArchivoDto? tipoSeleccionado;
    private int tipoArchivoSeleccionado = 0;
    private List<TipoArchivoDto> tiposArchivos = new();


    private string nuevoArchivoNombre = string.Empty;
    private IBrowserFile? nuevoArchivo;

    // Diccionario temporal para actualizar archivos
    private Dictionary<string, IBrowserFile> archivosSeleccionados = new();

    protected override async Task OnInitializedAsync()
    {
        tiposArchivo = await ArchivoService.ObtenerTiposAsync();
        await CargarPaciente();
    }

    private async Task CargarPaciente()
    {
        cargando = true;
        pacienteDetalle = await PacienteService.ObtenerPorIdAsync(id);

        archivosLista.Clear();

        if (pacienteDetalle?.Archivos != null)
        {
            foreach (var nombre in pacienteDetalle.Archivos)
            {
                archivosLista.Add(new AddArchivoBlazorDto
                {
                    Nombre = nombre,
                    Archivo = null! // para actualizar si se desea
                });
            }
        }


        cargando = false;
    }

    // ===============================
    // Subir nuevo archivo
    // ===============================
    private void OnNuevoArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        nuevoArchivoDto.Archivo = e.File;
    }

    private async Task SubirArchivo()
    {
        if (nuevoArchivoDto.TipoArchivoId == 0 || nuevoArchivoDto.Archivo == null)
        {
            mensajeOperacion = "Seleccione un tipo de archivo y un archivo válido.";
            return;
        }

        var tipo = tiposArchivo.FirstOrDefault(t => t.TipoId == nuevoArchivoDto.TipoArchivoId);
        if (tipo == null)
        {
            mensajeOperacion = "Tipo de archivo inválido.";
            return;
        }

        // Nombre que espera el backend
        nuevoArchivoDto.Nombre = tipo.Nombre;

        var (exito, mensaje) = await ArchivoService.SubirArchivoAsync(id, nuevoArchivoDto);
        mensajeOperacion = mensaje;

        if (exito)
        {
            archivosLista.Add(new AddArchivoBlazorDto
            {
                Nombre = nuevoArchivoDto.Nombre,
                Archivo = null!,
                TipoArchivoId = nuevoArchivoDto.TipoArchivoId
            });

            // Reset
            nuevoArchivoDto = new AddArchivoBlazorDto();
        }
    }

    // ===============================
    // Actualizar archivo existente
    // ===============================
    private void OnArchivoSeleccionado(InputFileChangeEventArgs e, string nombreArchivo)
    {
        archivosSeleccionados[nombreArchivo] = e.File;
    }

    private async Task ActualizarArchivo(string nombreArchivo)
    {
        if (!archivosSeleccionados.ContainsKey(nombreArchivo))
        {
            mensajeOperacion = "Seleccione un archivo para actualizar.";
            return;
        }

        var dto = new UpdateArchivoBlazorDto
        {
            Nombre = nombreArchivo,
            Archivo = archivosSeleccionados[nombreArchivo]
        };

        var (exito, mensaje) = await ArchivoService.ActualizarArchivoAsync(id, dto);
        mensajeOperacion = mensaje;
    }

    // ===============================
    // Eliminar archivo
    // ===============================
    private async Task EliminarArchivo(string nombreArchivo)
    {
        var (exito, mensaje) = await ArchivoService.EliminarArchivoAsync(id, nombreArchivo);
        mensajeOperacion = mensaje;

        if (exito)
        {
            var archivo = archivosLista.FirstOrDefault(a => a.Nombre == nombreArchivo);
            if (archivo != null)
                archivosLista.Remove(archivo);
        }
    }

    // ===============================
    // Descargar archivo
    // ===============================
    private async Task DescargarArchivo(AddArchivoBlazorDto archivo)
    {
        var (contenido, mensaje, extension) = await ArchivoService.DescargarArchivoAsync(id, archivo.Nombre);
        mensajeOperacion = mensaje;

        if (contenido != null)
        {
            var base64 = Convert.ToBase64String(contenido);
            await JS.InvokeVoidAsync("blazorDownloadFile", archivo.Nombre + extension, base64);
        }
    }
}
