<h3>EventConsole</h3>
<div style="height: 150px; overflow-y: auto; border: 1px solid gray; padding: 5px;">
    @foreach (var m in messages)
    {
        <div>@m</div>
    }
</div>

@code {
    private List<string> messages = new();

    public void Log(string msg)
    {
        messages.Add(msg);
        StateHasChanged();
    }
}

