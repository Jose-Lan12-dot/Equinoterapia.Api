@using FRONTproyectoEquinoterapia.Models
@using FRONTproyectoEquinoterapia.Services
@inject Radzen.DialogService DialogService
@inject FRONTproyectoEquinoterapia.Services.InstructorService InstructorService
@inject FRONTproyectoEquinoterapia.Services.CaballoService CaballoService
@inject IJSRuntime JS
@inject SesionesService SesionService
@inject AsistenciasService AsistenciaService




@if (Visible)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalles de la Sesión</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">

                    <p><strong>Fecha:</strong> @(DateOnly.Parse(Sesion.Fecha).ToString("dd/MM/yyyy"))</p>
                    <p><strong>Hora:</strong> @(TimeOnly.Parse(Sesion.Hora).ToString(@"hh\:mm"))</p>
                    <p><strong>Instructor:</strong> @Sesion.nombreInstructor</p>
                    <p><strong>Caballo:</strong> @Sesion.nombreCaballo</p>

                    <h6>Pacientes:</h6>
                    <ul>
                        @foreach (var p in Pacientes)
                        {
                            <li>@p.Nombre</li>
                        }
                    </ul>

                    <button class="btn btn-outline-primary" @onclick="AbrirAgregarPacientes">
                        <i class="bi bi-person-plus"></i> Agregar Paciente
                    </button>

                    <AgregarPacientesDialog @ref="AgregarPacientesDialogRef"
                                            OnPacientesAgregados="RecargarPacientes"
                                            VisibleChanged="@((v) => ModalAgregarVisible = v)" />

                    <button class="btn btn-danger ms-2" @onclick="EliminarSesion">Eliminar Sesión</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private bool Visible { get; set; }
    private GetOneSesionDto Sesion { get; set; } = new();
    private List<AllPacienteDto> Pacientes { get; set; } = new();

    private AgregarPacientesDialog AgregarPacientesDialogRef;
    private bool ModalAgregarVisible = false;

    [Parameter] public EventCallback OnSesionActualizada { get; set; }

    public async Task Abrir(Appointment appt)
    {
        if (appt.SesionId == null)
        {
            await JS.InvokeVoidAsync("alert", "La sesión no tiene un ID válido.");
            return;
        }

        // Obtener sesión por ID usando SesionesService
        Sesion = await SesionService.GetByIdAsync(appt.SesionId.Value);
        if (Sesion == null)
        {
            await JS.InvokeVoidAsync("alert", "No se pudo obtener la sesión.");
            return;
        }

        // Traer pacientes de la sesión usando el servicio de Asistencias
        Pacientes = await AsistenciaService.ObtenerPorSesionAsync(Sesion.SesionId) ?? new List<AllPacienteDto>();

        Visible = true;
        StateHasChanged();
    }

    private async Task AbrirAgregarPacientes()
    {
        int existentes = Pacientes?.Count ?? 0;
        await AgregarPacientesDialogRef.Abrir(Sesion.SesionId, existentes);
    }

    private async Task RecargarPacientes()
    {
        Pacientes = await AsistenciaService.ObtenerPorSesionAsync(Sesion.SesionId) ?? new List<AllPacienteDto>();
        StateHasChanged();
    }

    private async Task Cerrar()
    {
        Visible = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task EliminarSesion()
    {
        bool exito = await SesionService.DeleteAsync(Sesion.SesionId);
        if (exito)
        {
            await Cerrar();
            if (OnSesionActualizada.HasDelegate)
                await OnSesionActualizada.InvokeAsync();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "No se pudo eliminar la sesión.");
        }
    }
}
