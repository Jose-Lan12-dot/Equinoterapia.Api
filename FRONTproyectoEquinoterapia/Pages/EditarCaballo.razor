@page "/detalle-caballo/{CaballoId:int}"
@inject FRONTproyectoEquinoterapia.Services.CaballoService CaballoService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NotificationService NotificationService
@using Radzen
@using Radzen.Blazor
@using FRONTproyectoEquinoterapia.Models

<h3>Detalle del Caballo</h3>

@if (caballo == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="mb-3">
        <label>Placa:</label>
        <RadzenTextBox @bind-Value="caballo.Placa" Style="width:250px" Disabled="@(!modoEdicion)" />
    </div>

    <div class="mb-3">
        <label>Nombre:</label>
        <RadzenTextBox @bind-Value="caballo.Nombre" Style="width:250px" Disabled="@(!modoEdicion)" />
    </div>

    <div class="mb-3">
        <label>Fecha de Herraje:</label>
        <RadzenDatePicker @bind-Value="fechaHerrajeTemp" Style="width:250px" Disabled="@(!modoEdicion)" />
    </div>

    <div class="mb-3">
        <label>Padecimiento:</label>
        <RadzenTextBox @bind-Value="caballo.Padecimiento" Style="width:250px" Disabled="@(!modoEdicion)" />
    </div>

    <div class="mb-3">
        <label>Estado:</label>
        @if (modoEdicion)
        {
            <RadzenDropDown @bind-Value="caballo.Estado"
                            Data="@estadosDisponibles"
                            TextProperty="Text"
                            ValueProperty="Value"
                            Style="width:250px" />
        }
        else
        {
            <RadzenTextBox Value="@caballo.Estado" Style="width:250px" ReadOnly="true" />
        }
    </div>

    @if (!modoEdicion)
    {
        <RadzenButton Text="Editar" ButtonStyle="ButtonStyle.Primary" Click="@ActivarEdicion" />
        <RadzenButton Text="Regresar" ButtonStyle="ButtonStyle.Secondary" Click="@Regresar" Style="margin-left:5px" />
    }
    else
    {
        <RadzenButton Text="Guardar" ButtonStyle="ButtonStyle.Primary" Click="@GuardarCambios" Style="margin-right:5px" />
        <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" Click="@CancelarEdicion" />
    }
}


@code {
    [Parameter] public int CaballoId { get; set; }

    private CaballoDto? caballo;
    private bool modoEdicion = false;
    private DateTime fechaHerrajeTemp;

    // Lista de estados permitidos
    private List<Estado> estadosDisponibles = new()
    {
        new Estado { Value = "Activo", Text = "Activo" },
        new Estado { Value = "Disponible", Text = "Disponible" },
        new Estado { Value = "EnTratamiento", Text = "EnTratamiento" },
        new Estado { Value = "Descansando", Text = "Descansando" },
        new Estado { Value = "Retirado", Text = "Retirado" }
    };

    public class Estado
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            caballo = await CaballoService.GetByIdAsync(CaballoId);
            if (caballo != null)
            {
                fechaHerrajeTemp = caballo.FechaHerraje.ToDateTime(TimeOnly.MinValue);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar el caballo: {ex.Message}");
        }
    }

    private void ActivarEdicion()
    {
        modoEdicion = true;
    }

    private void CancelarEdicion()
    {
        modoEdicion = false;
        _ = OnInitializedAsync(); // restauramos los datos originales
    }

    private async Task GuardarCambios()
    {
        if (caballo == null) return;

        // Validaciones
        if (string.IsNullOrWhiteSpace(caballo.Placa) || caballo.Placa.Length != 10)
        {
            await JS.InvokeVoidAsync("alert", "La placa es obligatoria y debe tener 10 caracteres.");
            return;
        }

        if (string.IsNullOrWhiteSpace(caballo.Nombre))
        {
            await JS.InvokeVoidAsync("alert", "El nombre es obligatorio.");
            return;
        }

        if (fechaHerrajeTemp > DateTime.Now)
        {
            await JS.InvokeVoidAsync("alert", "La fecha de herraje no puede ser futura.");
            return;
        }

        // Convertimos la fecha
        caballo.FechaHerraje = DateOnly.FromDateTime(fechaHerrajeTemp);

        var updateDto = new UpdateCaballoDto
        {
            Placa = caballo.Placa,
            Nombre = caballo.Nombre,
            Estado = caballo.Estado,
            FechaHerraje = caballo.FechaHerraje,
            Padecimiento = caballo.Padecimiento
        };

        try
        {
            bool exito = await CaballoService.UpdatePartialAsync(CaballoId, updateDto);
            if (exito)
            {
                modoEdicion = false;
                await JS.InvokeVoidAsync("alert", "Caballo actualizado correctamente.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Error al actualizar el caballo.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al actualizar: {ex.Message}");
        }
    }

    private void Regresar()
    {
        Navigation.NavigateTo("/caballos");
    }
}

