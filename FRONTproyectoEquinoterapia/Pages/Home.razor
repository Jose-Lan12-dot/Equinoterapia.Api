@page "/inicio"

@using FRONTproyectoEquinoterapia.Pages.sesiones
@using FRONTproyectoEquinoterapia.Services
@using FRONTproyectoEquinoterapia.Models
@inject NavigationManager Nav
@inject PacienteService PacienteService
@inject SesionesService SesionService
@inject IJSRuntime JS

<div class="container mt-4">
    <div class="card p-3 mt-4 shadow-sm">
        <h5 class="mb-3">Buscador de Pacientes</h5>
        <input @bind="textoBusqueda"
               class="form-control"
               placeholder="Ingresa un nombre..."
               @oninput="OnInputChanged"
               @ref="txtBuscarRef" />
    </div>
    <!-- RESULTADOS DEL BUSCADOR -->
    @if (resultados?.Any() == true)
    {
        <div class="list-group mt-3">
            @foreach (var p in resultados)
            {
                <div class="list-group-item list-group-item-action"
                     style="cursor:pointer;"
                     @onclick='() => Nav.NavigateTo($"/pacientes/detalle/{p.Id}")'>
                    <strong>@p.Nombre</strong>
                    <div class="text-muted">@p.Estado</div>
                </div>
            }
        </div>
    }

    <!-- BOTONES RÁPIDOS -->
    <div class="row g-4 justify-content-center mt-4">

        <!-- AGREGAR PACIENTE -->
        <div class="col-md-3 col-sm-6 d-flex justify-content-center">
            <div class="text-center">
                <RadzenButton Icon="person_add"
                              ButtonStyle="ButtonStyle.Primary"
                              Style="width:250px; height:70px; border-radius:16px; display:flex; flex-direction:column; justify-content:center; align-items:center; font-size:16px; padding:10px;"
                              Click="@(() => Nav.NavigateTo("/agregar-paciente"))">
                    <span style="font-size:36px; margin-bottom:4px;">
                        <i class="material-icons">person_add</i>
                    </span>
                    Registrar Un Nuevo Paciente
                </RadzenButton>
            </div>
        </div>

        <!-- AGREGAR SESIÓN -->
        <div class="col-md-3 col-sm-6 d-flex justify-content-center">
            <div class="text-center">
                <RadzenButton Icon="event"
                              ButtonStyle="ButtonStyle.Success"
                              Style="width:250px; height:70px; border-radius:16px; display:flex; flex-direction:column; justify-content:center; align-items:center; font-size:16px; padding:10px;"
                              Click="@(() => agregarDialog.Abrir())">
                    <span style="font-size:36px; margin-bottom:4px;">
                        <i class="material-icons">event</i>
                    </span>
                    Registrar Nueva Sesión
                </RadzenButton>
            </div>
        </div>

        <AgregarSesionDialog @ref="agregarDialog" />

    </div>


    <!-- SESIONES HOY -->
    <h4 class="mt-5 text-primary">Sesiones de Hoy</h4>
    @if (!SesionesHoy.Any())
    {
        <p class="text-muted">No hay sesiones registradas hoy.</p>
    }
    else
    {
        @TablaSesiones(SesionesHoy)
    }

    <!-- PRÓXIMAS -->
    <h4 class="mt-5 text-primary">Sesiones En Las Próximas 7 Días</h4>
    @if (!SesionesProximas.Any())
    {
        <p class="text-muted">No hay sesiones próximas.</p>
    }
    else
    {
        @TablaSesiones(SesionesProximas)
    }
</div>

@code {
    private string textoBusqueda = "";
    private bool focusSearch = false;
    private ElementReference txtBuscarRef;
    private AgregarSesionDialog agregarDialog;
    private List<AllPacienteDto> listaPacientesCache = new();
    private List<PacienteBusquedaDto> resultados = new();

    private List<GetAllSesionDto> SesionesHoy = new();
    private List<GetAllSesionDto> SesionesProximas = new();

    protected override async Task OnInitializedAsync()
    {
        listaPacientesCache = await PacienteService.ObtenerTodosAsync();
        await CargarSesiones();
    }

    


    private async Task CargarSesiones()
    {
        var todas = await SesionService.GetAllAsync() ?? new List<GetAllSesionDto>();

        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var limite = hoy.AddDays(7);

        SesionesHoy = todas.Where(s => DateOnly.Parse(s.Fecha) == hoy).ToList();

        SesionesProximas = todas.Where(s =>
        {
            var f = DateOnly.Parse(s.Fecha);
            return f > hoy && f <= limite;
        }).ToList();

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusSearch)
        {
            await JS.InvokeVoidAsync("focusElement", txtBuscarRef);
            focusSearch = false;
        }
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        textoBusqueda = e?.Value?.ToString() ?? "";
        await RealizarBusquedaCliente();
    }

    private Task RealizarBusquedaCliente()
    {
        resultados = string.IsNullOrWhiteSpace(textoBusqueda)
            ? new()
            : listaPacientesCache
                .Where(p => p.Nombre != null &&
                            p.Nombre.ToLower().Contains(textoBusqueda.ToLower()))
                .Select(p => new PacienteBusquedaDto
                {
                    Id = p.PacienteId,
                    Nombre = p.Nombre,
                    Estado = p.Estado ?? ""
                })
                .ToList();

        return Task.CompletedTask;
    }

    public class PacienteBusquedaDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Estado { get; set; } = "";
    }

    RenderFragment TablaSesiones(List<GetAllSesionDto> lista) => __builder =>
    {
        <table class="table table-hover table-sm mt-3">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Instructor</th>
                    <th>Caballo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in lista)
                {
                    <tr style="cursor:pointer;"
                        @onclick="@(() => Nav.NavigateTo($"/sesiones/detalle/{s.SesionId}"))">
                        <td>@DateOnly.Parse(s.Fecha).ToString("dd/MM/yyyy")</td>
                        <td>@TimeOnly.Parse(s.Hora).ToString(@"hh\:mm")</td>
                        <td>@s.nombreInstructor</td>
                        <td>@s.nombreCaballo</td>
                    </tr>
                }
            </tbody>
        </table>
    };
}

