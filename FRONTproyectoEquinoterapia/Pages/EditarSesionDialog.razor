@using FRONTproyectoEquinoterapia.Models
@inject DialogService DialogService


@if (Visible)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Sesión</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Sesion" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label>Descripción</label>
                            <InputText @bind-Value="Sesion.Text" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Fecha</label>
                            <InputDate @bind-Value="Sesion.Start" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Hora inicio (HH:mm)</label>
                            <InputText @bind-Value="HoraInicio" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Hora fin (HH:mm)</label>
                            <InputText @bind-Value="HoraFin" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <button type="button" class="btn btn-secondary ms-2" @onclick="Cerrar">Cancelar</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [Parameter] public EventCallback OnSesionGuardada { get; set; }
    [Parameter] public Appointment Sesion { get; set; } = new Appointment();
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    // Simple: Hora como string para que Blazor no rompa bind
    private string HoraInicio
    {
        get => Sesion.Start.ToString("HH:mm");
        set
        {
            if (TimeOnly.TryParse(value, out var t))
            {
                Sesion.Start = Sesion.Start.Date.AddHours(t.Hour).AddMinutes(t.Minute);
            }
        }
    }

    private string HoraFin
    {
        get => Sesion.End.ToString("HH:mm");
        set
        {
            if (TimeOnly.TryParse(value, out var t))
            {
                Sesion.End = Sesion.End.Date.AddHours(t.Hour).AddMinutes(t.Minute);
            }
        }
    }
    public Task Abrir(Appointment sesion)
    {
        Sesion = sesion;
        Visible = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Cerrar()
    {
        Visible = false;
        VisibleChanged.InvokeAsync(false);
    }

    private async Task Guardar()
    {
        // guardar cambios
        await OnSesionGuardada.InvokeAsync(); // notifica al padre
    }

}
