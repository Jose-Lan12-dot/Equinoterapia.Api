@using FRONTproyectoEquinoterapia.Models
@using FRONTproyectoEquinoterapia.Services
@inject Radzen.DialogService DialogService
@inject SesionesService SesionesService
@inject AsistenciasService AsistenciaService
@inject InstructorService InstructorService
@inject CaballoService CaballoService
@inject IJSRuntime JS

@if (Visible && Sesion != null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Sesión</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Sesion" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label>Fecha</label>
                            <InputDate @bind-Value="Fecha" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Hora (HH:mm)</label>
                            <InputText @bind-Value="Hora" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Instructor</label>
                            <InputSelect @bind-Value="Sesion.InstructorId" class="form-control">
                                @foreach (var i in Instructores ?? new List<SimpleDto>())
                                {
                                    <option value="@i.Id">@i.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label>Caballo</label>
                            <InputSelect @bind-Value="Sesion.CaballoId" class="form-control">
                                @foreach (var c in Caballos ?? new List<SimpleDto>())
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <h6>Pacientes</h6>
                        <ul>
                            @foreach (var p in Pacientes ?? new List<GetAsistenciaDto>())
                            {
                                <li>@p.nombre</li>
                            }
                        </ul>
                        <button type="button" class="btn btn-outline-primary mb-3" @onclick="AbrirAgregarPacientes">
                            <i class="bi bi-person-plus"></i> Agregar/Quitar Pacientes
                        </button>

                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <button type="button" class="btn btn-secondary ms-2" @onclick="Cerrar">Cancelar</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>

    <AgregarPacientesDialog @ref="AgregarPacientesDialogRef"
                            OnPacientesAgregados="RecargarPacientes"
                            VisibleChanged="@((v) => ModalAgregarVisible = v)" />
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnSesionGuardada { get; set; }

    private GetOneSesionDto Sesion { get; set; } = new();
    private List<SimpleDto> Instructores { get; set; } = new();
    private List<SimpleDto> Caballos { get; set; } = new();
    private List<GetAsistenciaDto> Pacientes { get; set; } = new();

    private string Fecha { get; set; } = string.Empty;
    private string Hora { get; set; } = string.Empty;

    private AgregarPacientesDialog AgregarPacientesDialogRef;
    private bool ModalAgregarVisible = false;

    public async Task Abrir(GetOneSesionDto sesion)
    {
        if (sesion == null) return;

        Sesion = sesion;
        Fecha = Sesion.Fecha;
        Hora = Sesion.Hora;

        // Cargar instructores y caballos
        var instructoresDto = await InstructorService.GetAllAsync();
        Instructores = instructoresDto?.Select(i => new SimpleDto { Id = i.InstructorId, Nombre = i.Nombre }).ToList()
                        ?? new List<SimpleDto>();

        var caballosDto = await CaballoService.GetAllAsync();
        Caballos = caballosDto?.Select(c => new SimpleDto { Id = c.CaballoId, Nombre = c.Nombre }).ToList()
                   ?? new List<SimpleDto>();

        // Cargar pacientes
        await RecargarPacientes();

        Visible = true;
        await VisibleChanged.InvokeAsync(true);
        StateHasChanged();
    }

    private async Task AbrirAgregarPacientes()
    {
        int existentes = Pacientes?.Count ?? 0;
        if (AgregarPacientesDialogRef != null)
            await AgregarPacientesDialogRef.Abrir(Sesion.SesionId, existentes);
    }

    private async Task RecargarPacientes()
    {
        Pacientes = await AsistenciaService.GetAsistenciasPorSesion(Sesion.SesionId) ?? new List<GetAsistenciaDto>();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (Sesion == null) return;

        var updateDto = new UpdateSesionDto
        {
            Fecha = Fecha,
            Hora = Hora,
            InstructorId = Sesion.InstructorId,
            CaballoId = Sesion.CaballoId,
            PacienteIds = Pacientes?.Select(p => p.PacienteId).ToList() ?? new List<int>()
        };

        bool exito = await SesionesService.UpdateAsync(Sesion.SesionId, updateDto);
        if (exito)
        {
            await OnSesionGuardada.InvokeAsync();
            Cerrar();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Error al guardar la sesión.");
        }
    }

    private void Cerrar()
    {
        Visible = false;
        VisibleChanged.InvokeAsync(false);
    }
}
