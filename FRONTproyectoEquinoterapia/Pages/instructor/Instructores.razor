@page "/instructores"
@attribute [Authorize]
@using FRONTproyectoEquinoterapia.Services
@inject InstructorService InstructorService
@using FRONTproyectoEquinoterapia.Models
@inject NavigationManager Navigation
@inject HttpClient Http
@inject NotificationService NotificationService
@inject InstructorService InstructorService
@inject DialogService DialogService
@using Radzen
@using Radzen.Blazor

<div class="card shadow-sm p-4 mt-3 custom-card">

    <!-- Título con icono -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0 text-primary icon-title">
            <i class="material-icons">school</i>
            Lista de Instructores
        </h3>

        <RadzenButton Click="@AbrirAgregarInstructor"
                      Text="Registrar Un Nuevo Instructor"
                      Icon="add_circle"
                      ButtonStyle="ButtonStyle.Primary" />
    </div>

    <!-- Filtros -->
    <RadzenStack Orientation="Orientation.Horizontal" Gap="10px" Style="margin-bottom:15px">
        <RadzenDropDown Style="width: 100%; max-width: 300px;"
                        TValue="string"
                        @bind-Value="selectedOrder"
                        Placeholder="Selecciona orden"
                        Data="@ordenesDisponibles"
                        TextProperty="Text"
                        ValueProperty="Value"
                        Change="@(args => AplicarFiltros())"
                        AllowFiltering="true" />
    </RadzenStack>

    <RadzenTextBox @bind-Value="searchTerm"
                   Placeholder="Buscar instructor..."
                   Style="margin-bottom:15px; width:250px"
                   Change="@(args => AplicarFiltros())" />

    <!-- Grid -->
    <RadzenDataGrid Data="@filteredInstructores" TItem="InstructorDto" ColumnWidth="200px"
                    AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10"
                    class="shadow-sm rounded">
        <Columns>
            <RadzenDataGridColumn TItem="InstructorDto" Property="InstructorId" Title="ID" />
            <RadzenDataGridColumn TItem="InstructorDto" Property="Nombre" Title="Nombre" />
            <RadzenDataGridColumn TItem="InstructorDto" Property="Telefono" Title="Teléfono" />
            <RadzenDataGridColumn TItem="InstructorDto" Property="Estado" Title="Estado" />
            <RadzenDataGridColumn TItem="InstructorDto" Title="Operaciones">
                <Template Context="i">
                    <div class="btn-group">
                        <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Click="@(() => VerInstructor(i.InstructorId))" Size="ButtonSize.Small" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => ConfirmarEliminarInstructor(i))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</div>

<style>
    .custom-card {
        background-color: #f8f9fa; /* gris suave */
    }

    .icon-title i {
        vertical-align: middle;
        margin-right: 8px;
        color: #061f6d; /* azul logo */
    }

    .btn-group .rz-button {
        margin-right: 4px;
    }

    .rz-datagrid-table tr:hover {
        background-color: #e9ecef;
    }
</style>


@code {
    string searchTerm = "";
    string selectedOrder = "";

    List<InstructorDto> instructores = new();
    List<InstructorDto> filteredInstructores = new();

    public class Orden
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

    List<Orden> ordenesDisponibles = new()
    {
        new Orden { Value = "nombre_asc", Text = "Nombre (A-Z)" },
        new Orden { Value = "nombre_desc", Text = "Nombre (Z-A)" },
        new Orden { Value = "id_asc", Text = "ID (Más antiguo primero)" },
        new Orden { Value = "id_desc", Text = "ID (Más reciente primero)" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            instructores = await InstructorService.GetAllAsync();
            filteredInstructores = instructores.ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"No se pudieron cargar los instructores: {ex.Message}"
            });
        }
    }

    void AplicarFiltros()
    {
        var query = string.IsNullOrWhiteSpace(searchTerm)
            ? instructores
            : instructores.Where(i => (i.Nombre ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                      (i.Estado ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

        query = selectedOrder switch
        {
            "nombre_asc" => query.OrderBy(i => i.Nombre),
            "nombre_desc" => query.OrderByDescending(i => i.Nombre),
            "id_asc" => query.OrderBy(i => i.InstructorId),
            "id_desc" => query.OrderByDescending(i => i.InstructorId),
            _ => query
        };

        filteredInstructores = query.ToList();
        StateHasChanged();
    }

    void AbrirAgregarInstructor()
    {
        Navigation.NavigateTo("/agregar-instructor");
    }

    void VerInstructor(int id)
    {
        Navigation.NavigateTo($"/detalle-instructor/{id}");
    }

    void EditarInstructor(InstructorDto instructor)
    {
        Navigation.NavigateTo($"/editar-instructor/{instructor.InstructorId}");
    }

    [Inject] IJSRuntime JS { get; set; }

    private async Task ConfirmarEliminarInstructor(InstructorDto instructor)
    {
        if (instructor == null) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Seguro que deseas eliminar al instructor \"{instructor.Nombre}\"? Esta acción no se puede deshacer.");

        if (!confirm) return;

        bool exito = await InstructorService.DeleteAsync(instructor.InstructorId);

        if (exito)
        {
            instructores.Remove(instructor);  // Eliminamos de la lista local
            AplicarFiltros();                 // Actualizamos la tabla
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Instructor eliminado",
                Detail = $"Se eliminó correctamente al instructor \"{instructor.Nombre}\"."
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = "No se pudo eliminar al instructor."
            });
        }
    }
}
