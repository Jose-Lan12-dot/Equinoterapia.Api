@page "/detalle-instructor/{InstructorId:int}"
@attribute [Authorize]
@inject FRONTproyectoEquinoterapia.Services.InstructorService InstructorService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject DialogService DialogService
@using Radzen
@using Radzen.Blazor
@using FRONTproyectoEquinoterapia.Models

<div class="card shadow-sm p-4 mt-3">

    <div class="d-flex align-items-center mb-3">
        <i class="material-icons text-primary me-2">person</i>
        <h3 class="m-0">Detalle del Instructor</h3>
    </div>

    @if (instructor == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <div class="row">

            <!-- COLUMNA IZQUIERDA -->
            <div class="col-md-6">

                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre:</label>
                    <RadzenTextBox @bind-Value="instructor.Nombre"
                                   Style="width:100%"
                                   Disabled="@(!editarActivo)" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Teléfono:</label>
                    <RadzenTextBox @bind-Value="instructor.Telefono"
                                   Style="width:100%"
                                   Disabled="@(!editarActivo)" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Estado:</label>

                    @if (editarActivo)
                    {
                        <RadzenDropDown @bind-Value="instructor.Estado"
                                        Data="@estadosDisponibles"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Style="width:100%" />
                    }
                    else
                    {
                        <RadzenTextBox Value="@instructor.Estado"
                                       Style="width:100%"
                                       ReadOnly="true" />
                    }
                </div>

            </div>

            <!-- COLUMNA DERECHA CON UNA TARJETA -->
            <div class="col-md-6">
                <div class="p-3 border rounded bg-light">
                    <h5 class="text-secondary mb-2">Información general</h5>
                    <p class="small text-muted m-0">
                        Aquí puedes ver o editar los datos del instructor.
                        Si necesitas actualizar su estado, usa el selector correspondiente.
                    </p>
                </div>
            </div>

        </div>

        <!-- BOTONES ABAJO -->
        <div class="mt-4">

            @if (!editarActivo)
            {
                <RadzenButton Text="Editar"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@ActivarEdicion" />

                <RadzenButton Text="Regresar"
                              ButtonStyle="ButtonStyle.Secondary"
                              Click="@Regresar"
                              Style="margin-left:5px" />

                <RadzenButton Text="Eliminar El Instructor"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@ConfirmarEliminar"
                              Style="margin-left:5px" />
            }
            else
            {
                <RadzenButton Text="Guardar"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@GuardarCambios"
                              Style="margin-right:5px" />

                <RadzenButton Text="Cancelar"
                              ButtonStyle="ButtonStyle.Secondary"
                              Click="@CancelarEdicion" />
            }
        </div>

    }
</div>


@code {
    [Parameter] public int InstructorId { get; set; }

    private InstructorDto? instructor;
    private bool editarActivo = false;

    // Lista de estados permitidos
    private List<Estado> estadosDisponibles = new()
    {
        new Estado { Value = "Activo", Text = "Activo" },
        new Estado { Value = "Baja", Text = "Baja" },
        new Estado { Value = "EnDescanso", Text = "EnDescanso" }
    };

    public class Estado
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            instructor = await InstructorService.GetByIdAsync(InstructorId);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar el instructor: {ex.Message}");
        }
    }

    void ActivarEdicion()
    {
        editarActivo = true;
    }

    void CancelarEdicion()
    {
        if (InstructorId > 0)
        {
            _ = OnInitializedAsync(); // restaurar valores
        }
        editarActivo = false;
    }

    private async Task GuardarCambios()
    {
        if (instructor == null) return;

        // Validaciones
        if (string.IsNullOrWhiteSpace(instructor.Nombre))
        {
            await JS.InvokeVoidAsync("alert", "El nombre es obligatorio.");
            return;
        }

        if (string.IsNullOrWhiteSpace(instructor.Telefono))
        {
            await JS.InvokeVoidAsync("alert", "El teléfono es obligatorio.");
            return;
        }

        var updateDto = new UpdateInstructorDto
        {
            Nombre = instructor.Nombre,
            Telefono = instructor.Telefono,
            Estado = instructor.Estado
        };

        try
        {
            bool exito = await InstructorService.UpdatePartialAsync(InstructorId, updateDto);
            if (exito)
            {
                editarActivo = false;
                await JS.InvokeVoidAsync("alert", "Instructor actualizado correctamente.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Error al actualizar el instructor.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al actualizar: {ex.Message}");
        }
    }

    void Regresar()
    {
        Navigation.NavigateTo("/instructores");
    }

    private async Task ConfirmarEliminar()
    {
        if (instructor == null) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Seguro que deseas eliminar al instructor \"{instructor.Nombre}\"? Esta acción no se puede deshacer.");

        if (!confirm) return;

        bool exito = await InstructorService.DeleteAsync(InstructorId);
        if (exito)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Instructor eliminado",
                Detail = $"Se eliminó correctamente al instructor \"{instructor.Nombre}\"."
            });
            Navigation.NavigateTo("/instructores");
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = "No se pudo eliminar al instructor."
            });
        }
    }
}

