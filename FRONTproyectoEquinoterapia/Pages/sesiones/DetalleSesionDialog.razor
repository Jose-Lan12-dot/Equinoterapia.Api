@using FRONTproyectoEquinoterapia.Models
@using FRONTproyectoEquinoterapia.Services

@inject InstructorService InstructorService
@inject CaballoService CaballoService
@inject SesionesService SesionService
@inject AsistenciasService AsistenciaService
@inject IJSRuntime JS

@if (Visible)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Detalles de la Sesión</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>

                <div class="modal-body">

                    <!-- INFO SESIÓN -->
                    @if (!EditarActivo)
                    {
                        <div class="mb-3">
                            <p><strong>Fecha:</strong> @Fecha.ToString("dd/MM/yyyy")</p>
                            <p><strong>Hora:</strong> @Hora.ToString(@"hh\:mm")</p>
                            <p><strong>Instructor:</strong> @Sesion.nombreInstructor</p>
                            <p><strong>Caballo:</strong> @Sesion.nombreCaballo</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="Sesion" OnValidSubmit="GuardarEdicion">
                            <DataAnnotationsValidator />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label>Fecha</label>
                                    <InputDate @bind-Value="Fecha" class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label>Hora</label>
                                    <InputTime @bind="Hora" class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label>Instructor</label>
                                    <InputSelect @bind-Value="Sesion.InstructorId" class="form-select">
                                        @foreach (var i in Instructores)
                                        {
                                            <option value="@i.Id">@i.Nombre</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-md-6">
                                    <label>Caballo</label>
                                    <InputSelect @bind-Value="Sesion.CaballoId" class="form-select">
                                        @foreach (var c in Caballos)
                                        {
                                            <option value="@c.Id">@c.Nombre</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelarEdicion">
                                    Cancelar
                                </button>
                            </div>
                        </EditForm>
                    }

                    <!-- PACIENTES -->
                    <div class="mt-4">
                        <h6>Pacientes</h6>
                        <ul class="list-group">
                            @foreach (var p in Pacientes)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @p.nombre

                                    @if (EditarActivo)
                                    {
                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => QuitarPaciente(p)">
                                            Quitar
                                        </button>
                                    }
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- BOTONES -->
                    <div class="d-flex flex-wrap gap-2 mt-4">

                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="AbrirPaseLista">
                            Pasar lista
                        </button>

                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="ActivarEdicion">
                            Editar sesión
                        </button>

                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="AbrirAgregarPacientes">
                            Agregar paciente
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="EliminarSesion">
                            Eliminar sesión
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop show"></div>

    <!-- DIALOGS -->
    <AgregarPacientesDialog @ref="AgregarPacientesDialogRef"
                            OnPacientesAgregados="RecargarPacientes" />

    <PasarListaDialog @ref="PasarListaDialogRef"
                      OnListaGuardada="RecargarPacientes" />
}

@code {

    private bool Visible;
    private bool EditarActivo;

    private GetOneSesionDto Sesion = new();
    private List<GetAsistenciaDto> Pacientes = new();

    private List<SimpleDto> Instructores = new();
    private List<SimpleDto> Caballos = new();

    private DateOnly Fecha = DateOnly.FromDateTime(DateTime.Now);
    private TimeOnly Hora = TimeOnly.FromDateTime(DateTime.Now);

    private AgregarPacientesDialog AgregarPacientesDialogRef;
    private PasarListaDialog PasarListaDialogRef;
    private DateTime FechaHoraSesion =>Fecha.ToDateTime(Hora);

    [Parameter] public EventCallback OnSesionActualizada { get; set; }


    

    public async Task Abrir(Appointment appt)
    {
        Sesion = await SesionService.GetByIdAsync(appt.SesionId!.Value);
        Pacientes = await AsistenciaService.GetAsistenciasPorSesion(Sesion.SesionId) ?? [];

        Instructores = (await InstructorService.GetAllAsync())
            .Select(i => new SimpleDto { Id = i.InstructorId, Nombre = i.Nombre }).ToList();

        Caballos = (await CaballoService.GetAllAsync())
            .Select(c => new SimpleDto { Id = c.CaballoId, Nombre = c.Nombre }).ToList();

        Fecha = DateOnly.Parse(Sesion.Fecha);
        Hora = TimeOnly.Parse(Sesion.Hora);

        Visible = true;
        StateHasChanged();
    }

    private string ObtenerEstado(GetAsistenciaDto p)
    {
        if (FechaHoraSesion > DateTime.Now)
            return "Pendiente";

        return p.Asistio ? "Asistió" : "Falta";
    }


    private void ActivarEdicion() => EditarActivo = true;

    private void CancelarEdicion()
    {
        EditarActivo = false;
        Fecha = DateOnly.Parse(Sesion.Fecha);
        Hora = TimeOnly.Parse(Sesion.Hora);
    }

    private async Task GuardarEdicion()
    {
        var dto = new UpdateSesionDto
        {
            Fecha = Fecha.ToString("yyyy-MM-dd"),
            Hora = Hora.ToString("HH:mm"),
            InstructorId = Sesion.InstructorId,
            CaballoId = Sesion.CaballoId,
            PacienteIds = Pacientes.Select(p => p.PacienteId).ToList()
        };

        if (await SesionService.UpdateAsync(Sesion.SesionId, dto))
        {
            EditarActivo = false;
            await RecargarSesion();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Error al guardar");
        }
    }

    private async Task QuitarPaciente(GetAsistenciaDto p)
    {
        var (ok, _) = await AsistenciaService.DeleteAsistencias([p.AsistenciaId]);
        if (ok)
        {
            Pacientes.Remove(p);
            StateHasChanged();
        }
    }

    private async Task AbrirAgregarPacientes()
    {
        await AgregarPacientesDialogRef.Abrir(Sesion.SesionId, Pacientes.Count);
    }

    private async Task AbrirPaseLista()
    {
        await PasarListaDialogRef.Abrir(Sesion.SesionId);
    }

    private async Task RecargarSesion()
    {
        Sesion = await SesionService.GetByIdAsync(Sesion.SesionId);
        Pacientes = await AsistenciaService.GetAsistenciasPorSesion(Sesion.SesionId) ?? [];
        StateHasChanged();

        if (OnSesionActualizada.HasDelegate)
            await OnSesionActualizada.InvokeAsync();
    }

    private async Task RecargarPacientes()
    {
        Pacientes = await AsistenciaService.GetAsistenciasPorSesion(Sesion.SesionId) ?? [];
        StateHasChanged();
    }

    private async Task EliminarSesion()
    {
        if (await SesionService.DeleteAsync(Sesion.SesionId))
        {
            await Cerrar();
            if (OnSesionActualizada.HasDelegate)
                await OnSesionActualizada.InvokeAsync();
        }
    }

    private async Task Cerrar()
    {
        Visible = false;
        EditarActivo = false;
        await InvokeAsync(StateHasChanged);
    }
}
