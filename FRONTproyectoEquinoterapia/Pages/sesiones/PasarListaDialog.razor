@using FRONTproyectoEquinoterapia.Models
@using FRONTproyectoEquinoterapia.Services

@inject AsistenciasService AsistenciaService

@if (Visible)
{
    <div class="modal show d-block">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Pasar lista</h5>
                    <button class="btn-close" @onclick="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <ul class="list-group">
                        @foreach (var p in Pacientes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @p.nombre
                                <input type="checkbox" @bind="p.Asistio" />
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-end mt-3 gap-2">
                        <button class="btn btn-secondary btn-sm" @onclick="Cerrar">
                            Cancelar
                        </button>

                        <button class="btn btn-success btn-sm" @onclick="Guardar">
                            Guardar lista
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop show"></div>
}

@code {
    private bool Visible;
    private int SesionId;
    private List<GetAsistenciaDto> Pacientes = new();

    [Parameter] public EventCallback OnListaGuardada { get; set; }

    public async Task Abrir(int sesionId)
    {
        SesionId = sesionId;
        Pacientes = await AsistenciaService.GetAsistenciasPorSesion(sesionId) ?? [];
        Visible = true;
        StateHasChanged();
    }

    private async Task Guardar()
    {
        await AsistenciaService.UpdateAsistencias(new UpdateAsistenciaDto
        {
            Asistencias = Pacientes.Select(p => new UpdateAsistenciaItemDto
            {
                AsistenciasId = p.AsistenciaId,
                Asistio = p.Asistio
            }).ToList()
        });

        Visible = false;
        await OnListaGuardada.InvokeAsync();
    }

    private void Cerrar()
    {
        Visible = false;
        StateHasChanged();
    }
}
