@page "/agregar-paciente"
@using FRONTproyectoEquinoterapia.Models
@using FRONTproyectoEquinoterapia.Services
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Forms
@inject ArchivoService ArchivoService
@inject PacienteService pacienteService
@inject PacienteService PacienteService
@inject ArchivoService ArchivoService
@inject HttpClient Http
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@using System.Text.Json


<div class="card shadow-sm p-4 mt-3">

    <h3 class="mb-3 text-primary">Agregar paciente</h3>

    <RadzenTemplateForm Data="@nuevoPaciente" TItem="PacienteFormDTO" Submit="@GuardarPaciente">

        <!-- Información del paciente -->
        <div class="row g-3">

            <div class="col-md-6">
                <RadzenTextBox @bind-Value="nuevoPaciente.Nombre"
                               Placeholder="Nombre"
                               Style="width:100%;" />
            </div>

            <div class="col-md-6">
                <RadzenDatePicker @bind-Value="nuevoPaciente.FechaNacimiento"
                                  Placeholder="Fecha de nacimiento"
                                  Style="width:100%;" />
            </div>

            <div class="col-md-6">
                <RadzenTextBox @bind-Value="nuevoPaciente.Tutor"
                               Placeholder="Tutor"
                               Style="width:100%;" />
            </div>

            <div class="col-md-6">
                <RadzenTextBox @bind-Value="nuevoPaciente.TelefonoTutor"
                               Placeholder="Teléfono tutor"
                               Style="width:100%;" />
            </div>

            <div class="col-md-6">
                <RadzenDropDown @bind-Value="nuevoPaciente.Genero"
                                Data="@generos"
                                Placeholder="Selecciona género"
                                Style="width:100%;" />
            </div>

        </div>

        <hr class="my-4" />

        <!-- Archivos -->
        <h5 class="text-secondary">Archivos (opcionales)</h5>

        <div class="mt-3">

            @foreach (var tipo in tiposArchivos)
            {
                <div class="border rounded p-3 mb-3 bg-light">

                    <label class="fw-bold">
                        @tipo.Nombre (@tipo.Extension)
                    </label>

                    <div class="mt-2">
                        <InputFile class="form-control"
                                   OnChange="@(e => ManejarArchivo(e, tipo))" />
                    </div>

                    @if (archivoPreviews.ContainsKey(tipo.Nombre))
                    {
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <span>
                                Archivo seleccionado:
                                <strong>@archivoPreviews[tipo.Nombre].Name</strong>
                            </span>

                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    @onclick="() => QuitarArchivo(tipo.Nombre)">
                                Quitar
                            </button>
                        </div>
                    }

                </div>
            }

        </div>

        <div class="mt-3 text-end">
            <RadzenButton Text="Guardar paciente"
                          ButtonStyle="ButtonStyle.Primary"
                          Type="Submit"
                          Style="padding:8px 20px;" />
        </div>

    </RadzenTemplateForm>

</div>

@code {
    private PacienteFormDTO nuevoPaciente = new();
    private Dictionary<string, IBrowserFile> archivoPreviews = new();
    private readonly string[] generos = { "Masculino", "Femenino", "Otro" };
    private List<ArchivoService.TipoArchivoDto> tiposArchivos = new();

    protected override async Task OnInitializedAsync()
    {
        tiposArchivos = await ArchivoService.ObtenerTiposAsync();
    }

    private void ManejarArchivo(InputFileChangeEventArgs e, ArchivoService.TipoArchivoDto tipo)
    {
        var archivo = e.File;
        if (!archivo.Name.EndsWith(tipo.Extension, StringComparison.OrdinalIgnoreCase))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Archivo inválido",
                Detail = $"Debe ser un archivo {tipo.Extension}"
            });
            return;
        }

        archivoPreviews[tipo.Nombre] = archivo;
    }

    private void QuitarArchivo(string nombre)
    {
        archivoPreviews.Remove(nombre);
    }

    private async Task GuardarPaciente(PacienteFormDTO paciente)
    {
        try
        {
            // 1️⃣ Crear paciente solo con datos
            var pacienteDto = new AddPacienteDto
            {
                Nombre = paciente.Nombre ?? "",
                Tutor = paciente.Tutor ?? "",
                TelefonoTutor = paciente.TelefonoTutor ?? "",
                Genero = paciente.Genero ?? "",
                
            };

            (bool exito, string mensaje, int pacienteId) = await pacienteService.AgregarPacienteSoloDatosAsync(pacienteDto);

            if (!exito)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al crear paciente",
                    Detail = mensaje
                });
                return;
            }

            // 2️⃣ Subir archivos si hay
            foreach (var kvp in archivoPreviews)
            {
                var tipo = kvp.Key;
                var archivo = kvp.Value;

                (bool exitoArchivo, string mensajeArchivo) = await ArchivoService.SubirArchivoAsync(pacienteId, archivo, tipo);

                if (!exitoArchivo)
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Warning,
                        Summary = $"Error al subir archivo {tipo}",
                        Detail = mensajeArchivo
                    });
                }
            }

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Paciente guardado",
                Detail = "Paciente y archivos guardados correctamente"
            });

            Navigation.NavigateTo("/pacientes");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error inesperado",
                Detail = ex.Message
            });
        }
    }





}

