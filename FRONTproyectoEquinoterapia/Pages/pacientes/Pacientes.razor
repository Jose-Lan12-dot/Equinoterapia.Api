@page "/pacientes"
@using FRONTproyectoEquinoterapia.Services
@using FRONTproyectoEquinoterapia.Models
@inject NavigationManager Navigation
@inject HttpClient Http
@inject NotificationService NotificationService
@inject PacienteService pacienteService
@inject DialogService DialogService
@using Radzen
@using Radzen.Blazor


<div class="card shadow-sm p-4 mt-3 custom-card">

    <!-- Título con icono -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0 text-primary icon-title">
            <i class="material-icons">group</i>
            Lista de Pacientes
        </h3>

        <RadzenButton Click="@AbrirAgregarPaciente"
                      Text="Registrar Un Nuevo Paciente"
                      Icon="add_circle"
                      ButtonStyle="ButtonStyle.Primary" />
    </div>

    <!-- Filtros -->
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <RadzenTextBox @bind-Value="searchTerm"
                           Placeholder="Buscar paciente..."
                           Style="width:100%;"
                           Change="@(args => AplicarFiltros())" />
        </div>

        <div class="col-md-4">
            <RadzenDropDown Style="width:100%;"
                            TValue="string"
                            @bind-Value="selectedOrder"
                            Placeholder="Ordenar por"
                            Data="@ordenesDisponibles"
                            TextProperty="Text"
                            ValueProperty="Value"
                            Change="@(args => AplicarFiltros())"
                            AllowFiltering="true" />
        </div>
    </div>

    <!-- Grid -->
    <RadzenDataGrid Data="@filteredPacientes"
                    TItem="AllPacienteDto"
                    ColumnWidth="200px"
                    AllowFiltering="true"
                    AllowPaging="true"
                    AllowSorting="true"
                    PageSize="5"
                    class="shadow-sm rounded">

        <Columns>
            <RadzenDataGridColumn TItem="AllPacienteDto" Property="PacienteId" Title="ID" />
            <RadzenDataGridColumn TItem="AllPacienteDto" Property="Nombre" Title="Nombre" />
            <RadzenDataGridColumn TItem="AllPacienteDto" Property="NumeroFaltas" Title="Faltas" />
            <RadzenDataGridColumn TItem="AllPacienteDto" Property="Estado" Title="Estado" />

            <RadzenDataGridColumn TItem="AllPacienteDto" Title="Operaciones">
                <Template Context="p">
                    <div class="btn-group">
                        <RadzenButton Icon="visibility"
                                      ButtonStyle="ButtonStyle.Info"
                                      Click="@(args => VerPaciente(p.PacienteId))"
                                      Size="ButtonSize.Small" />

                        <RadzenButton Icon="delete"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Click="@(args => ConfirmarEliminarConJs(p))"
                                      Size="ButtonSize.Small" />

                        <RadzenButton ButtonStyle="@(p.FormularioHecho? ButtonStyle.Success: ButtonStyle.Warning)"
                                      Click="@(args => IrAEvaluacion(p.PacienteId, p.FormularioHecho))"
                                      Size="ButtonSize.Small"
                                      Text="@(p.FormularioHecho ? "Evaluación Completada" : "Realizar Evaluación")" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>

    </RadzenDataGrid>

</div>

<style>
    .custom-card {
        background-color: #f8f9fa; /* gris suave */
    }

    .icon-title i {
        vertical-align: middle;
        margin-right: 8px;
        color: #061f6d; /* azul logo */
    }

    .btn-group .rz-button {
        margin-right: 4px;
    }

    .rz-datagrid-table tr:hover {
        background-color: #e9ecef;
    }
</style>


@code {
    string searchTerm = "";
    string selectedOrder = "";

    List<AllPacienteDto> pacientes = new();
    List<AllPacienteDto> filteredPacientes = new();

    public class Orden
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

    List<Orden> ordenesDisponibles = new()
    {
        new Orden { Value = "nombre_asc", Text = "Nombre (A-Z)" },
        new Orden { Value = "nombre_desc", Text = "Nombre (Z-A)" },
        new Orden { Value = "faltas_asc", Text = "Faltas (Menor a Mayor)" },
        new Orden { Value = "faltas_desc", Text = "Faltas (Mayor a Menor)" },
        new Orden { Value = "id_asc", Text = "ID (Más antiguo primero)" },
        new Orden { Value = "id_desc", Text = "ID (Más reciente primero)" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarPacientes();
            filteredPacientes = pacientes.ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"No se pudieron cargar los pacientes: {ex.Message}"
            });
        }
    }

    void AplicarFiltros()
    {
        var query = string.IsNullOrWhiteSpace(searchTerm)
            ? pacientes
            : pacientes.Where(p => (p.Nombre ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                   (p.Estado ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

        query = selectedOrder switch
        {
            "nombre_asc" => query.OrderBy(p => p.Nombre),
            "nombre_desc" => query.OrderByDescending(p => p.Nombre),
            "faltas_asc" => query.OrderBy(p => p.NumeroFaltas),
            "faltas_desc" => query.OrderByDescending(p => p.NumeroFaltas),
            "id_asc" => query.OrderBy(p => p.PacienteId),
            "id_desc" => query.OrderByDescending(p => p.PacienteId),
            _ => query
        };

        filteredPacientes = query.ToList();
        StateHasChanged();
    }

    void AbrirAgregarPaciente()
    {
        Navigation.NavigateTo("/agregar-paciente");
    }

    void VerPaciente(int id)
    {
        Navigation.NavigateTo($"/pacientes/detalle/{id}");
    }

    void EditarPaciente(AllPacienteDto paciente)
    {
        Navigation.NavigateTo($"/editar-paciente/{paciente.PacienteId}");
    }
    void IrAEvaluacion(int pacienteId)
    {
        Navigation.NavigateTo($"/evaluacion/{pacienteId}");
    }



    [Inject] IJSRuntime JS { get; set; }

    async Task ConfirmarEliminarConJs(AllPacienteDto paciente)
    {
        if (paciente == null) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Seguro que deseas eliminar al paciente \"{paciente.Nombre}\"? Esta acción eliminará también TODOS sus archivos y registros asociados.");

        if (!confirm) return;

        var (exito, mensaje) = await pacienteService.EliminarPacienteAsync(paciente.PacienteId);

        if (exito)
        {
            await CargarPacientes();
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Paciente eliminado",
                Detail = mensaje
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = mensaje
            });
        }
    }


    //manda a la evaluacion existente }
    void IrAEvaluacion(int pacienteId, bool formularioHecho)
    {
        if (formularioHecho)
        {
            // Ya existe evaluación → Editar/Ver evaluación
            Navigation.NavigateTo($"/editar-evaluacion/{pacienteId}");
            
        }
        else
        {
            // No existe evaluación → Crear evaluación
            Navigation.NavigateTo($"/evaluacion/{pacienteId}");
            
        }
    }


    private async Task CargarPacientes()
    {
        pacientes = await pacienteService.ObtenerTodosAsync();
        filteredPacientes = pacientes.ToList();
        StateHasChanged();
    }




}
