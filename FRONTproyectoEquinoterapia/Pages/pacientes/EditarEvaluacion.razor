@page "/editar-evaluacion/{PacienteId:int}"
@attribute [Authorize]

@using FRONTproyectoEquinoterapia.Services
@using FRONTproyectoEquinoterapia.Models
@using Radzen
@using Radzen.Blazor

@inject EvaluacionService EvaluacionService
@inject NavigationManager Navigation

<!-- COLUMNA DERECHA CON UNA TARJETA -->
<div class="row justify-content-end">
    <div class="col-md-6">
        <div class="p-3 border rounded bg-light">
            <h5 class="text-secondary mb-2">Información general</h5>
            <p class="small text-muted m-0">
                Aquí puedes ver y editar la evaluacion del paciente.
                Al terminar usa el selector correspondiente.
            </p>
        </div>
    </div>
</div>

<div class="card shadow-sm p-4 mt-3">


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary mb-0">Editar Evaluación</h3>
        <div>
            <label class="form-label fw-bold me-2">Fecha:</label>
            <input type="text" class="form-control" style="width:150px;" value="@evaluacion?.Fecha" disabled />
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center my-4">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">Cargando evaluación...</p>
        </div>
    }
    else if (evaluacion == null)
    {
        <div class="alert alert-danger">No existe una evaluación registrada para este paciente.</div>
    }
    else
    {
        <h5 class="mb-3"><strong>Paciente:</strong> @evaluacion.nombrePaciente</h5>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger">@mensajeError</div>
        }

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success">@mensajeExito</div>
        }

        @if (evaluacion.Preguntas != null && evaluacion.Preguntas.Count > 0)
        {
            <div class="row g-3 mt-2">
                @for (int i = 0; i < evaluacion.Preguntas.Count; i++)
                {
                    var pregunta = evaluacion.Preguntas[i];

                    // Obtiene la respuesta existente o inicializa
                    var respuesta = evaluacion.Respuestas?.FirstOrDefault(r => r.PreguntaId == pregunta.Orden);
                    if (respuesta == null)
                    {
                        respuesta = new RespuestasDto { PreguntaId = pregunta.Orden, Respuesta = 1 };
                        evaluacion.Respuestas ??= new List<RespuestasDto>();
                        evaluacion.Respuestas.Add(respuesta);
                    }

                    <div class="col-md-12">
                        <div class="d-flex justify-content-between align-items-center p-3 border rounded bg-light">
                            <div>
                                <label class="form-label mb-0"><b>@pregunta.Orden. @pregunta.Pregunta</b></label>
                            </div>
                            <div>
                                <RadzenNumeric @bind-Value="respuesta.Respuesta"
                                               Min="1" Max="10"
                                               Style="width:90px;" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning">No hay preguntas disponibles para esta evaluación.</div>
        }

        <div class="mt-4 d-flex">
            <RadzenButton Text="Guardar Cambios"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@GuardarCambios" />

            <RadzenButton Text="Cancelar"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="@Cancelar"
                          Style="margin-left:10px;" />
        </div>
    }
</div>

@code {
    [Parameter] public int PacienteId { get; set; }

    private GetEvaluacionDto? evaluacion;
    private bool cargando = true;

    private string? mensajeError;
    private string? mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            evaluacion = await EvaluacionService.GetEvaluacionAsync(PacienteId) ?? new GetEvaluacionDto
            {
                Preguntas = new List<PreguntasDto>(),
                Respuestas = new List<RespuestasDto>()
            };
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar la evaluación: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarCambios()
    {
        mensajeError = mensajeExito = null;

        if (evaluacion == null) return;

        // Validación de respuestas
        if (evaluacion.Respuestas.Any(r => r.Respuesta < 1 || r.Respuesta > 10))
        {
            mensajeError = "Todas las respuestas deben estar entre 1 y 10.";
            return;
        }

        var dto = new UpdateEvaluacionDto
        {
            Fecha = evaluacion.Fecha,
            Respuestas = evaluacion.Respuestas
        };

        var (exito, mensaje) = await EvaluacionService.ActualizarEvaluacionAsync(PacienteId, dto);

        if (!exito)
        {
            mensajeError = mensaje;
            return;
        }

        mensajeExito = "Evaluación actualizada correctamente.";

        // Redirigir después de un segundo para que vea el mensaje
        await Task.Delay(900);
        Navigation.NavigateTo("/pacientes");
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/pacientes");
    }
}
