<h3>ArchivoView</h3>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? ArchivoUrl { get; set; }
    [Parameter] public bool IsImage { get; set; } = false;
}

<div style="margin-bottom:10px;">
    <strong>@Label:</strong>
    @if (!string.IsNullOrEmpty(ArchivoUrl))
    {
        @if (IsImage)
        {
            <img src="@ArchivoUrl" width="150" />
        }
        else
        {
            <a href="@ArchivoUrl" target="_blank">Ver archivo</a>
        }
    }
    else
    {
        <span>No hay archivo</span>
    }
</div>

