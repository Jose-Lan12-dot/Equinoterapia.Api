@page "/"
@attribute [AllowAnonymous]
@layout LoginLayout



@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.LocalStorage
@using FRONTproyectoEquinoterapia.Models
@using FRONTproyectoEquinoterapia.Services
@using Radzen
@using Radzen.Blazor

@inject InicioSesionService InicioSesionService
@inject ILocalStorageService localStorage
@inject AuthenticationStateProvider AuthProvider
@inject UsuarioSesionService UsuarioSesionService
@inject NavigationManager NavigationManager




<main>
    <div class="login-card">
    <div style="
        display:flex;
        flex-direction:column;
        align-items:center;
        justify-content:center;
        width:100%;
        max-width:400px;
        background:#e9e9e9;
        border-radius:24px;
        box-shadow:0 8px 35px rgba(0,0,0,0.1);
        padding:50px 60px;
        position:relative;
        overflow:hidden;
        transition:transform 0.3s ease, box-shadow 0.3s ease;
    "
         onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 45px rgba(0,0,0,0.12)';"
         onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 35px rgba(0,0,0,0.1)';">

        <!-- Decoración -->
        <div style="
            position:absolute;
            top:-100px;
            right:-100px;
            width:220px;
            height:220px;
            border-radius:50%;
            background:radial-gradient(circle at 30% 30%, #061f6d 0%, transparent 70%);
            opacity:0.08;
        "></div>


            <img src="/imagenes/logo.png"
                 alt="Logo Equinoterapia"
                 class="login-logo" />

    <!-- TODO lo que ya tienes del login va aquí dentro -->

        <!-- Título -->
        <RadzenLabel Text="Sistema de Gestión de Equinoterapia"
                     Style="font-weight:800; color:#222; text-align:center; margin-bottom:8px; letter-spacing:0.7px; font-size:1.4rem;" />
        <RadzenLabel Text="Accede a tu cuenta para continuar"
                     Style="color:#666; text-align:center; margin-bottom:24px; font-size:0.95rem;" />

        <!-- Campos -->
        <RadzenTextBox @bind-Value="usuario"
                       Name="Usuario"
                       Placeholder="Usuario"
                       Style="width:100%; border-radius:10px; margin-bottom:12px;" />

        <RadzenPassword @bind-Value="contrasena"
                        Name="Contraseña"
                        Placeholder="Contraseña"
                        Style="width:100%; border-radius:10px; margin-bottom:18px;" />
       
        <!-- Botón con efecto hover -->
        <RadzenButton Text="Iniciar sesión"
                      Style="width:100%;
                             margin-top:15px;
                             background:linear-gradient(90deg,#061f6d);
                             color:white; font-weight:700; font-size:1rem;
                             padding:12px 0; border-radius:10px;
                             box-shadow:0 4px 14px rgba(184,17,49,0.25);
                             transition:all 0.3s ease;
                             cursor:pointer;"
                      onmouseover="this.style.filter='brightness(1.1)'; this.style.boxShadow='0 6px 18px rgba(184,17,49,0.35)';"
                      onmouseout="this.style.filter='brightness(1)'; this.style.boxShadow='0 4px 14px rgba(184,17,49,0.25)';"
                      Click="@IniciarSesion" />
        </div>
        <!-- Link de recuperación con efecto hover -->
        <div style="display:flex; align-items:center; justify-content:center; margin-top:20px; cursor:pointer;"
             onclick="@RecuperarContrasena"
             onmouseover="this.style.textDecoration='underline'; this.style.color='#B81131';"
             onmouseout="this.style.textDecoration='none'; this.style.color='#555';">
            <RadzenLabel Text="¿Olvidaste tu contraseña?"
                         Style="color:#555; font-size:0.9rem; transition:all 0.25s ease;" />
        </div>

        <!-- Mensaje de alerta -->
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <RadzenAlert Severity="AlertSeverity.Error"
                         Style="width:100%; margin-top:15px;
                                    background:rgba(184,17,49,0.07);
                                    border-left:4px solid #B81131;
                                    border-radius:6px; color:#B81131;">
                @mensaje
            </RadzenAlert>
        }
    </div>
</main>


@code {
    private string usuario = string.Empty;
    private string contrasena = string.Empty;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // Ya está logueado → fuera del login
            NavigationManager.NavigateTo("/inicio", true);
        }
    }


    private async Task IniciarSesion()
    {
        var datos = new InicioSesionModel
        {
            usuario = usuario,
            contrasena = contrasena
        };

        var (exito, mensajeServidor, data) =
            await InicioSesionService.AccesoAsync(datos);

        if (exito && data != null)
        {
            // Guardar token
            await localStorage.SetItemAsync("token", data.Token);

            // Notificar autenticación
            var customAuth = (CustomAuthStateProvider)AuthProvider;
            await customAuth.MarkUserAsAuthenticated(data.Token);

            // Datos para UI
            UsuarioSesionService.Usuario = new UsuarioSesionDto
            {
                Nombre = data.NombreUsuario,
                FotoBase64 = data.FotoPerfil != null
                    ? Convert.ToBase64String(data.FotoPerfil)
                    : null
            };

            UsuarioSesionService.NotifyStateChanged();

            NavigationManager.NavigateTo("/inicio");
        }
        else
        {
            mensaje = mensajeServidor;
        }
    }



    private void RecuperarContrasena()
    {
        NavigationManager.NavigateTo("/recuperarContrase");
    }
}

