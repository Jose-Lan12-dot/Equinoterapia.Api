@page "/caballos"
@attribute [Authorize]
@using FRONTproyectoEquinoterapia.Services
@using FRONTproyectoEquinoterapia.Models
@inject CaballoService CaballoService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService
@using Radzen
@using Radzen.Blazor

<div class="card shadow-sm p-4 mt-3 custom-card">

    <!-- Título con icono -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0 text-primary icon-title">
            <i class="material-icons">directions_run</i>
            Lista de Caballos
        </h3>

        <RadzenButton Click="@AbrirAgregarCaballo"
                      Text="Registrar Un Nuevo Caballo"
                      Icon="add_circle"
                      ButtonStyle="ButtonStyle.Primary" />
    </div>

    <!-- Filtros -->
    <RadzenStack Orientation="Orientation.Horizontal" Gap="10px" Style="margin-bottom:15px">
        <RadzenDropDown Style="width: 100%; max-width: 300px;"
                        TValue="string"
                        @bind-Value="selectedOrder"
                        Placeholder="Selecciona orden"
                        Data="@ordenesDisponibles"
                        TextProperty="Text"
                        ValueProperty="Value"
                        Change="@(args => AplicarFiltros())"
                        AllowFiltering="true" />
    </RadzenStack>

    <RadzenTextBox @bind-Value="searchTerm"
                   Placeholder="Buscar caballo..."
                   Style="margin-bottom:15px; width:250px"
                   Change="@(args => AplicarFiltros())" />

    <!-- Grid -->
    <RadzenDataGrid Data="@filteredCaballos" TItem="CaballoDto" ColumnWidth="200px"
                    AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10"
                    class="shadow-sm rounded">
        <Columns>
            <RadzenDataGridColumn TItem="CaballoDto" Property="CaballoId" Title="ID" />
            <RadzenDataGridColumn TItem="CaballoDto" Property="Nombre" Title="Nombre" />
            <RadzenDataGridColumn TItem="CaballoDto" Property="Estado" Title="Estado" />
            <RadzenDataGridColumn TItem="CaballoDto" Property="FechaHerraje" Title="Fecha de Herraje" />
            <RadzenDataGridColumn TItem="CaballoDto" Title="Operaciones">
                <Template Context="c">
                    <div class="btn-group">
                        <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Click="@(() => VerCaballo(c.CaballoId))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(args => ConfirmarEliminarConJs(c))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</div>

<style>
    .custom-card {
        background-color: #f8f9fa; /* gris suave */
    }

    .icon-title i {
        vertical-align: middle;
        margin-right: 8px;
        color: #061f6d; /* azul logo */
    }

    .btn-group .rz-button {
        margin-right: 4px;
    }

    .rz-datagrid-table tr:hover {
        background-color: #e9ecef;
    }
</style>


@code {
    string searchTerm = "";
    string selectedOrder = "";

    List<CaballoDto> caballos = new();
    List<CaballoDto> filteredCaballos = new();

    public class Orden
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

    List<Orden> ordenesDisponibles = new()
    {
        new Orden { Value = "nombre_asc", Text = "Nombre (A-Z)" },
        new Orden { Value = "nombre_desc", Text = "Nombre (Z-A)" },
        new Orden { Value = "id_asc", Text = "ID (Más antiguo primero)" },
        new Orden { Value = "id_desc", Text = "ID (Más reciente primero)" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            caballos = await CaballoService.GetAllAsync();
            filteredCaballos = caballos.ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"No se pudieron cargar los caballos: {ex.Message}"
            });
        }
    }

    void AplicarFiltros()
    {
        var query = string.IsNullOrWhiteSpace(searchTerm)
            ? caballos
            : caballos.Where(c =>
                (c.Nombre ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (c.Placa ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (c.Estado ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

        query = selectedOrder switch
        {
            "nombre_asc" => query.OrderBy(c => c.Nombre),
            "nombre_desc" => query.OrderByDescending(c => c.Nombre),
            "id_asc" => query.OrderBy(c => c.CaballoId),
            "id_desc" => query.OrderByDescending(c => c.CaballoId),
            _ => query
        };

        filteredCaballos = query.ToList();
        StateHasChanged();
    }

    void AbrirAgregarCaballo()
    {
        Navigation.NavigateTo("/agregar-caballo");
    }

    void VerCaballo(int id)
    {

        Navigation.NavigateTo($"/detalle-caballo/{id}");
    }

    void EditarCaballo(CaballoDto caballo)
    {
        Navigation.NavigateTo($"/editar-caballo/{caballo.CaballoId}");
    }

    [Inject] IJSRuntime JS { get; set; }
    

    private async Task ConfirmarEliminarConJs(CaballoDto caballo)
    {
        if (caballo == null) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Seguro que deseas eliminar al caballo \"{caballo.Nombre}\"? Esta acción no se puede deshacer.");

        if (!confirm) return;

        bool exito = await CaballoService.DeleteAsync(caballo.CaballoId);

        if (exito)
        {
            caballos.Remove(caballo);      // Eliminamos de la lista local
            AplicarFiltros();              // Actualizamos la tabla
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Caballo eliminado",
                Detail = $"Se eliminó correctamente el caballo \"{caballo.Nombre}\"."
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = "No se pudo eliminar el caballo."
            });
        }
    }
}
