@page "/agregar-caballo"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject FRONTproyectoEquinoterapia.Services.CaballoService CaballoService
@inject IJSRuntime JS
@using Radzen
@using Radzen.Blazor
@using FRONTproyectoEquinoterapia.Models

<div class="row justify-content-end">
    <div class="col-md-6">
        <div class="p-3 border rounded bg-light">
            <h5 class="text-secondary mb-2">Información general</h5>
            <p class="small text-muted m-0">
                Aquí registrarás un nuevo caballo, asegúrate de no dejar campos vacíos.
                Al terminar usa el selector correspondiente.
            </p>
        </div>
    </div>
</div>
<div class="card shadow-sm p-4 mt-3" style="max-width: 500px; margin-left: 20px;">

    <h3 class="mb-4 text-primary">
        <i class="material-icons" style="vertical-align: middle;">directions_run</i>
        Agregar Caballo
    </h3>

    

    <!-- Placa -->
    <div class="mb-3">
        <label class="form-label">Placa:</label>
        <RadzenTextBox @bind-Value="NuevoCaballo.Placa" Style="width:100%" Placeholder="Ingresa la placa" />
    </div>

    <!-- Nombre -->
    <div class="mb-3">
        <label class="form-label">Nombre:</label>
        <RadzenTextBox @bind-Value="NuevoCaballo.Nombre" Style="width:100%" Placeholder="Ingresa el nombre" />
    </div>

    <!-- Fecha de Herraje -->
    <div class="mb-3">
        <label class="form-label">Fecha de Herraje:</label>
        <RadzenDatePicker @bind-Value="fechaHerrajeTemp" Style="width:100%" />
    </div>

    <!-- Padecimiento -->
    <div class="mb-3">
        <label class="form-label">Padecimiento:</label>
        <RadzenTextBox @bind-Value="NuevoCaballo.Padecimiento" Style="width:100%" Placeholder="Opcional" />
    </div>

    <!-- Botones -->
    <div class="mt-3">
        <RadzenButton Text="Guardar" Click="@GuardarCaballo" ButtonStyle="ButtonStyle.Primary" Style="margin-right:10px" />
        <RadzenButton Text="Cancelar" Click="@Cancelar" ButtonStyle="ButtonStyle.Secondary" />
    </div>

</div>


@code {
    private AddCaballoDto NuevoCaballo = new AddCaballoDto();
    // Para enlazar con RadzenDatePicker
    private DateTime fechaHerrajeTemp = DateTime.Now;


    private async Task GuardarCaballo()
    {
        // Validaciones
        if (string.IsNullOrWhiteSpace(NuevoCaballo.Placa))
        {
            await JS.InvokeVoidAsync("alert", "La placa es obligatoria.");
            return;
        }
        if (NuevoCaballo.Placa.Length != 10)
        {
            await JS.InvokeVoidAsync("alert", "La placa debe tener 10 caracteres.");
            return;
        }
        if (string.IsNullOrWhiteSpace(NuevoCaballo.Nombre))
        {
            await JS.InvokeVoidAsync("alert", "El nombre es obligatorio.");
            return;
        }
        if (DateOnly.FromDateTime(fechaHerrajeTemp) > DateOnly.FromDateTime(DateTime.Now))
        {
            await JS.InvokeVoidAsync("alert", "La fecha de herraje no puede ser futura.");
            return;
        }

        Console.WriteLine($">>>>>>>>>.{NuevoCaballo.Padecimiento}.");

        if (NuevoCaballo.Padecimiento == null || NuevoCaballo.Padecimiento == "") NuevoCaballo.Padecimiento = "Ninguno";


        
        // Asignamos la fecha al DTO
        NuevoCaballo.FechaHerraje = DateOnly.FromDateTime(fechaHerrajeTemp);




        try
        {
            // Llamamos al servicio que ya maneja DateOnly con JsonConverter
            var exito = await CaballoService.AddAsync(NuevoCaballo);

            if (exito)
            {
                await JS.InvokeVoidAsync("alert", "Caballo agregado correctamente.");
                Navigation.NavigateTo("/caballos");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Error al agregar el caballo.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al agregar el caballo: {ex.Message}");
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/caballos");
    }
}
