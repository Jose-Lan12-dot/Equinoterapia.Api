@page "/sesiones"
@using FRONTproyectoEquinoterapia.Models

@inject FRONTproyectoEquinoterapia.Services.SesionesService SesionesService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Sesiones</h3>
    <button class="btn btn-primary" @onclick="() => agregarDialog.Abrir()">Agregar Sesión</button>
</div>

<RadzenScheduler @ref="scheduler" TItem="Appointment"
                 Data="@appointments"
                 StartProperty="Start"
                 EndProperty="End"
                 TextProperty="Text"
                 AppointmentMove="@OnAppointmentMove"
                 AppointmentSelect="@OnAppointmentSelect"
                 DaySelect="@OnDaySelect"
                 Style="height: 700px;">
    <RadzenDayView />
    <RadzenWeekView />
    <RadzenMonthView />
</RadzenScheduler>

<AgregarSesionDialog @ref="agregarDialog" OnSesionAgregada="RefrescarCalendario" />
<DetalleSesionDialog @ref="detallesDialog" OnSesionActualizada="RefrescarCalendario" />

@code {
    private RadzenScheduler<Appointment> scheduler;
    private AgregarSesionDialog agregarDialog;
    private DetalleSesionDialog detallesDialog;

    private IList<Appointment> appointments = new List<Appointment>();

    protected override async Task OnInitializedAsync()
    {
        await CargarSesiones();
    }

    private DateTime CombinarFechaHora(string fecha, string hora)
    {
        var f = DateTime.Parse(fecha);
        var h = TimeSpan.Parse(hora);
        return f.Date + h;
    }

    private async Task CargarSesiones()
    {
        var sesiones = await SesionesService.GetAllAsync(); // aquí ya tienes la lista

        appointments = sesiones.Select(s => new Appointment
        {
            Start = CombinarFechaHora(s.Fecha, s.Hora),
            End = CombinarFechaHora(s.Fecha, s.Hora).AddHours(1),
            Text = $"{s.nombreInstructor} - {s.nombreCaballo} ({s.Hora:hh\\:mm})",
            SesionId = s.SesionId
        }).ToList();
    }




    private async Task RefrescarCalendario()
    {
        await CargarSesiones();
        if (scheduler != null)
        {
            await scheduler.Reload();
        }
    }

    private async Task OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<Appointment> args)
    {
        await detallesDialog.Abrir(args.Data);
    }

    private async Task OnDaySelect(SchedulerDaySelectEventArgs args)
    {
        var nueva = new Appointment
        {
            Start = args.Day,
            End = args.Day.AddHours(1),
            Text = ""
        };

        await agregarDialog.Abrir(nueva);
    }

    private async Task OnAppointmentMove(SchedulerAppointmentMoveEventArgs args)
    {
        if (args.Appointment.Data is Appointment appt)
        {
            var duration = appt.End - appt.Start;
            appt.Start = args.SlotDate;
            appt.End = args.SlotDate + duration;
        }

        await RefrescarCalendario();
    }
}
