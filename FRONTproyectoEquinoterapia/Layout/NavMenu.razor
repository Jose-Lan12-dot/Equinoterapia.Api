@using FRONTproyectoEquinoterapia.Models
@using FRONTproyectoEquinoterapia.Services
@implements IDisposable
@inject AuthenticationStateProvider AuthProvider
@inject CustomAuthStateProvider CustomAuth
@inject UsuarioSesionService UsuarioSesionService
@inject NavigationManager NavigationManager


<AuthorizeView>
    <Authorized>
        <div class="@NavMenuCssClass sidebar">

            <!-- Logo arriba -->
            <div class="sidebar-logo">
                <img src="/imagenes/logo.png" alt="Logo Equinoterapia" />
            </div>


            <!-- MENU -->
            <RadzenPanelMenu Style="width:100%; background-color:transparent; color:#061f6d;"
                             Click="OnParentClicked"
                             Multiple="@multiple">

                <RadzenPanelMenuItem Text="Inicio" Path="inicio" Icon="home" />
                <RadzenPanelMenuItem Text="Pacientes" Path="Pacientes" Icon="account_circle" />
                <RadzenPanelMenuItem Text="Instructores" Path="Instructores" Icon="psychology" />
                <RadzenPanelMenuItem Text="Caballos" Path="Caballos" Icon="pets" />
                <RadzenPanelMenuItem Text="Sesiones" Path="/sesiones" Icon="event_note" />
                <RadzenPanelMenuItem Text="Informes" Path="Informes" Icon="assessment" />


                <!-- USUARIO LOGUEADO -->
                @if (UsuarioSesionService.Usuario != null)
                {


                    <div class="usuario-sesion">
                        <div class="avatar">
                            @if (!string.IsNullOrEmpty(UsuarioSesionService.Usuario.FotoBase64))
                            {
                                <img src="data:image/png;base64,@UsuarioSesionService.Usuario.FotoBase64" />
                            }
                            else
                            {
                                <i class="bi bi-person-fill"></i>
                            }
                        </div>

                        <div class="nombre-usuario">
                            @UsuarioSesionService.Usuario.Nombre
                        </div>
                    </div>
                }

                <!-- CERRAR SESIÓN -->
                <button class="btn-cerrar" @onclick="Logout">
                    Cerrar sesión
                </button>
            </RadzenPanelMenu>

           

        </div>
    </Authorized>
</AuthorizeView>
        <style>
            .sidebar {
                width: 200px;
                min-height: 100vh;
                background-color: #eff1f6;
                transition: all 0.3s ease;
                overflow-y: auto;
                overflow-x: hidden;
            }

                .sidebar .rz-panelmenu-item {
                    color: #061f6d !important;
                    padding: 0.5rem 1rem;
                    width: 100%;
                }

                    .sidebar .rz-panelmenu-item:hover {
                        background-color: #5a8c3f;
                        color: #ffffff !important;
                    }

                .sidebar .rz-panelmenu-item-selected {
                    background-color: #eeb636;
                    color: #061f6d !important;
                }

            /* LOGO */
            .sidebar-logo {
                text-align: center;
                padding: 1.5rem 0;
            }

                .sidebar-logo img {
                    max-width: 50%;
                    height: auto;
                }

            /* USUARIO */
            .usuario-sesion {
                display: flex;
                flex-direction: column;
                align-items: center;
                padding: 1rem 0.5rem;
                border-bottom: 1px solid #ddd;
            }

            .avatar {
                width: 64px;
                height: 64px;
                border-radius: 50%;
                background-color: #061f6d;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                margin-bottom: 0.5rem;
            }

                .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

                .avatar i {
                    color: white;
                    font-size: 32px;
                }

            .nombre-usuario {
                font-weight: 600;
                color: #061f6d;
                font-size: 0.9rem;
                text-align: center;
                word-break: break-word;
            }


            /* CERRAR SESIÓN */
            .btn-cerrar {
                width: 50%;
                margin: 1rem auto;
                display: block;
                background-color: transparent;
                border: 1px solid #de6d6c;
                color: #de6d6c;
                padding: 0.4rem;
                border-radius: 6px;
                cursor: pointer;
            }

                .btn-cerrar:hover {
                    background-color: #de6d6c;
                    color: white;
                }

        </style>

        @code {
            private bool collapseNavMenu = false;
            private bool multiple = true;

            private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

        protected override void OnInitialized()
        {
        UsuarioSesionService.OnChange += StateHasChanged;
        }

        public void Dispose()
        {
        UsuarioSesionService.OnChange -= StateHasChanged;
        }




            private void ToggleNavMenu()
            {
                collapseNavMenu = !collapseNavMenu;
            }

            void OnParentClicked(MenuItemEventArgs args)
            {
                Console.WriteLine($"{args.Text} clicked from parent");
            }

            private async Task Logout()
            {
                await CustomAuth.LogoutAsync();
                UsuarioSesionService.Usuario = null;
                NavigationManager.NavigateTo("/", true);
            }

        }
