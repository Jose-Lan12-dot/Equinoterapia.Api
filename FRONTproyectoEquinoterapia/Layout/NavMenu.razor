<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FRONTproyectoEquinoterapia</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <RadzenPanelMenu Click="OnParentClicked" Style="width:100%;" Multiple="@multiple">
        <RadzenPanelMenuItem Text="Home" Path="home" Icon="home"></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Informes" Path="Informes" Icon="Assessment"></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Pacientes" Path="Pacientes" Icon="account_circle"></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Instructores" Path="Instructores" Icon="Psychology"></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Caballos" Path="Caballos" Icon="Psychology"></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Sesiones" Path="/sesiones" Icon="event_note" />
        <RadzenPanelMenuItem Text="Weather" Path="weather" Icon="list"></RadzenPanelMenuItem>
    </RadzenPanelMenu>
</div>


@code {
    private bool collapseNavMenu = true;
    private bool multiple = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    void OnParentClicked(MenuItemEventArgs args)
    {
        Console.WriteLine($"{args.Text} clicked from parent");
    }
}
