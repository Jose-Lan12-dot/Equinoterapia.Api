@using FRONTproyectoEquinoterapia.Services
@inject AuthenticationStateProvider AuthProvider
@inject UsuarioSesionService UsuarioSesionService
@inject NavigationManager NavigationManager

@inherits LayoutComponentBase

<div class="app @(usuarioAutenticado ? "page-layout" : "")">
    @if (usuarioAutenticado)
    {
        <NavMenu />
    }

    <main>
        @Body
    </main>
</div>

@code {
    private bool usuarioAutenticado;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        usuarioAutenticado = auth.User.Identity?.IsAuthenticated == true;

        if (usuarioAutenticado && UsuarioSesionService.Usuario == null)
        {
            try
            {
                await UsuarioSesionService.CargarPerfilAsync();
            }
            catch (UnauthorizedAccessException)
            {
                // Token expirado o inválido
                UsuarioSesionService.Usuario = null;
                NavigationManager.NavigateTo("/", true);
            }
        }
    }
}

<style>
    .page-layout {
        display: flex;
        min-height: 100vh;
        background-image: url('/imagenes/fondogeneral.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    main {
        flex: 1;
    }
</style>