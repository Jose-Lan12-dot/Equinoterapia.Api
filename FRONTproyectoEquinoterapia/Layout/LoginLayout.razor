@inherits LayoutComponentBase

<div class="login-layout">
    @Body
</div>

<style>
    .login-layout {
        display: flex;
        justify-content: flex-end; /*lo manda hacia la derecha*/
        align-items: center;
        padding-right: 130px; /*  aquí lo mides */
        height: 100vh;
        /* Imagen de fondo */
        background-image: url('/imagenes/Fondologin.png');        /* ruta relativa desde wwwroot */
        background-size: cover; /* que ocupe todo el contenedor */
        background-position: center; /* centrada */
        background-repeat: no-repeat; /* no se repita */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-card {
        background-color: #e9e9e9;
        padding: 60px 60px; /* vertical | horizontal */
        border-radius: 18px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.25);
        width: 100%;
        max-width: 600px; /* 👈 aquí mandas */

        text-align: center;
    }


        .login-card h3 {
            margin-bottom: 25px;
            font-size: 22px;
            color: #333;
            font-weight: 600;
        }

        .login-card .radzen-textbox {
            margin-bottom: 15px;
        }

    .login-logo {
        width: 120px; /* controla el tamaño */
        max-width: 100%;
        margin-bottom: 18px;
        display: block;
    }


</style>


